{
	"name": "@zerosumstudio/drift",
	"version": "1.0.0",
	"description": "A DOM-driven form library that tracks forms and fields by their presence in the DOM",
	"keywords": [
		"form",
		"forms",
		"dom",
		"form-state",
		"form-validation",
		"validation",
		"typescript",
		"vanilla-js"
	],
	"homepage": "https://github.com/zerosumstudio/drift#readme",
	"bugs": {
		"url": "https://github.com/zerosumstudio/drift/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zerosumstudio/drift.git"
	},
	"license": "MIT",
	"author": "zerosum studio <hello@zerosum.studio>",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./track": {
			"types": "./dist/track.d.ts",
			"default": "./dist/track.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs/migration-1.0.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepublishOnly": "pnpm run verify",
		"size": "size-limit",
		"smoke": "node scripts/smoke.mjs",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"type-check": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
		"verify": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build && pnpm run size && pnpm run smoke"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@size-limit/preset-small-lib": "^14.3.0",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"size-limit": "^14.3.0",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.1.1"
	},
	"packageManager": "pnpm@11.6.0",
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"size-limit": [
		{
			"name": "ESM bundle",
			"path": "dist/index.js",
			"limit": "9.2 KB"
		},
		{
			"name": "track subpath",
			"path": "dist/track.js",
			"limit": "400 B"
		}
	]
}
